# ============================================================
#  .env.example  —  Copia este archivo como .env y rellénalo
#  NUNCA subas el archivo .env real a Git
# ============================================================

# ── LLM (elige uno) ─────────────────────────────────────────
OPENAI_API_KEY=sk-...             # OpenAI GPT-4o
ANTHROPIC_API_KEY=sk-ant-...      # Claude 3.5

# ── Proveedor activo: "openai" | "anthropic" | "ollama" ─────
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o                  # o claude-3-5-sonnet-20241022

# ── Embeddings ───────────────────────────────────────────────
EMBEDDING_MODEL=text-embedding-3-small   # cambia si usas Anthropic/Ollama

# ── Vector Store: "chroma" | "faiss" ────────────────────────
VECTOR_STORE=chroma
CHROMA_PERSIST_DIR=./data/chroma_db

# ── Rutas de datos ───────────────────────────────────────────
GIT_REPOS_DIR=./data/git_repos
EXCEL_DIR=./data/excel
DRAWIO_DIR=./data/drawio
DOCS_DIR=./data/docs

# ── Chunking ────────────────────────────────────────────────
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
