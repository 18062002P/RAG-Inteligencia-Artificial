# ============================================================
#  .env.example  —  Copia este archivo como .env y rellénalo
#  NUNCA subas el archivo .env real a Git
# ============================================================

# ── LLM (elige uno) ─────────────────────────────────────────
GROQ_API_KEY=gsk_...              # Groq
OPENAI_API_KEY=sk-...             # opcional
ANTHROPIC_API_KEY=sk-ant-...      # opcional

# ── Proveedor activo: "groq" | "openai" | "anthropic" ─────
LLM_PROVIDER=groq
LLM_MODEL=llama-3.1-70b-versatile

# ── Embeddings ───────────────────────────────────────────────
EMBEDDING_PROVIDER=huggingface
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ── Vector Store: "chroma" | "faiss" ────────────────────────
VECTOR_STORE=chroma
CHROMA_PERSIST_DIR=./data/chroma_db

# ── Rutas de datos ───────────────────────────────────────────
GIT_REPOS_DIR=./data/git_repos
EXCEL_DIR=./data/excel
DRAWIO_DIR=./data/drawio
DOCS_DIR=./data/docs

# ── Chunking ────────────────────────────────────────────────
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
